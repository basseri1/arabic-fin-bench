[{"bbox": [1213, 199, 1457, 233], "text": "صندوق الرياض للإعمار"}, {"bbox": [1202, 235, 1457, 269], "text": "صندوق استثماري مفتوح"}, {"bbox": [1095, 269, 1455, 302], "text": "مدار من قبل شركة الرياض المالية"}, {"bbox": [870, 302, 1457, 338], "text": "قائمة التغيرات في حقوق الملكية العائدة إلى حاملى الوحدات"}, {"bbox": [988, 341, 1456, 375], "text": "المبالغ بالريالات السعودية مالم يذكر غير ذلك"}, {"bbox": [260, 408, 570, 452], "text": "للسنة المنتهية في ٣١ ديسمبر"}, {"bbox": [258, 450, 329, 480], "text": "٢٠٢٢"}, {"bbox": [497, 451, 572, 480], "text": "٢٠٢٣"}, {"bbox": [250, 518, 403, 552], "text": "١٤،٥٠٢،٨٦٧"}, {"bbox": [482, 518, 640, 552], "text": "١٢،١٠٧،٣٩١"}, {"bbox": [885, 515, 1439, 557], "text": "حقوق الملكية العائدة إلى حاملي الوحدات فى بداية السنة"}, {"bbox": [254, 591, 414, 630], "text": "٢،٦٨٨،٠٠٣"}, {"bbox": [496, 589, 642, 624], "text": "٣،٣٦٣،٤٦٠"}, {"bbox": [1035, 587, 1440, 629], "text": "مجموع الدخل الخسارة الشاملة للسنة"}, {"bbox": [958, 660, 1441, 695], "text": "الاشتراكات والاستردادات من قبل حاملي الوحدات"}, {"bbox": [264, 699, 403, 730], "text": "٧،٢٩٠،٠٦٤"}, {"bbox": [500, 701, 642, 729], "text": "١،٨٣١،٦٨٨"}, {"bbox": [1282, 697, 1442, 734], "text": "إصدار الوحدات"}, {"bbox": [254, 733, 413, 768], "text": "٧،٠٢،٥٣٧"}, {"bbox": [486, 732, 652, 768], "text": "٨،٠١٩،٩٨"}, {"bbox": [1277, 736, 1440, 767], "text": "استرداد الوحدات"}, {"bbox": [290, 769, 404, 801], "text": "٢٤٢،٥٢٧"}, {"bbox": [485, 768, 654, 808], "text": "،٦٨،٢٩٩"}, {"bbox": [1104, 772, 1439, 803], "text": "صافي التغير من معاملات الوحدات"}, {"bbox": [249, 843, 402, 874], "text": "١٢،١٠٧،٣٩١"}, {"bbox": [498, 843, 644, 874], "text": "٨،٧٨٢،٥٠٧"}, {"bbox": [881, 838, 1439, 877], "text": "حقوق الملكية العائدة إلى حاملي الوحدات في نهاية السنة"}, {"bbox": [624, 915, 1455, 951], "text": "تعتبر الإيضاحات المرفقة من رقم ١ إلى رقم ١٧ جزءاً لا يتجزأ من هذه القوائم المالية"}, {"bbox": [808, 2246, 827, 2270], "text": "٧"}]