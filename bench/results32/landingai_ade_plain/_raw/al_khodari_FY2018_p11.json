{"job_id": "parse-01m40kb9177k5q4g5qpbze8m27", "status": "completed", "created_at": "2026-10-03T10:00:55.083832+00:00", "completed_at": "2026-10-03T10:01:02.922527+00:00", "result": {"markdown": "شركة أبناء عبدالله عبدالمحسن الخضري\n(شركة مساهمة سعودية)\n\n\nقائمة التدفقات النقدية الموحدة\nللسنة المنتهية في ٣١ ديسمبر ٢٠١٨\n(جميع المبالغ بالريالات السعودية)\n\n\n<table>\n<tr><td>٣١ ديسمبر ٢٠١٧<br>(معدلة)</td><td>٣١ ديسمبر ٢٠١٨</td><td></td></tr>\n<tr><td></td><td></td><td>التدفقات النقدية من الأنشطة التشغيلية</td></tr>\n<tr><td>(٥٤,١٧١,٣٦٤)</td><td>(١,٥٩٢,٥٥٠,٦٩٣)</td><td>صافي الخسارة قبل الزكاة</td></tr>\n<tr><td></td><td></td><td>تعديلات لـ:</td></tr>\n<tr><td>٩٥,٣٤٩,٧٢٨</td><td>٦٠,٨١٧,٧٣٧</td><td>الاستهلاك</td></tr>\n<tr><td>٥٦٢,٧٧٢</td><td>٥٠٧,٤٨٧</td><td>اطفاء موجودات غير ملموسة</td></tr>\n<tr><td>٧,٤٦٧,٧٦٨</td><td>١٠٨,٣٥٢,٨٠٧</td><td>اطفاء تكاليف التجهيز المؤجلة</td></tr>\n<tr><td>—</td><td>١٢,٢٢١,٢٠٤</td><td>الإنخفاض في قيمة الممتلكات والمعدات والموجودات مصنفة كمحتفظ بها بغرض البيع</td></tr>\n<tr><td>—</td><td>٧,٦٨٥,٦٦٧</td><td>إنخفاض في قيمة الموجودات الأخرى</td></tr>\n<tr><td>—</td><td>(٦,٩٤١,٨٤٠)</td><td>الدخل من قرض بدون فوائد</td></tr>\n<tr><td>—</td><td>٩,٠٢٧,٧٠٠</td><td>مخصص مخزون بطيء الحركة ومتقادم</td></tr>\n<tr><td>—</td><td>٣٠,٢٣٠,٩٤٩</td><td>مخصص خسائر متوقعة</td></tr>\n<tr><td>١,٥٥٣,٢٢٢</td><td>١,٨٢٤,٩٧٠</td><td>مخصص ضمان، صافي</td></tr>\n<tr><td>٥٤,٣٠٥</td><td>(٢,٦٧٧,٦١٥)</td><td>صافي (رد) / تكوين مخصص إستعادة موقع</td></tr>\n<tr><td>(٨,٦٠٧,١٤٧)</td><td>١٣٥,٣٦١,٠٢٩</td><td>تكوين / (رد) مخصص الإنخفاض في قيمة الذمم المدينة</td></tr>\n<tr><td>(٣٩,٤١٦,٤٥٧)</td><td> - </td><td>مخصص الإنخفاض في قيمة موجودات العقود</td></tr>\n<tr><td> - </td><td>١٧٠,٦٣٨,٢٩٣</td><td>شطب موجودات العقود بسبب التغير في التقديرات</td></tr>\n<tr><td> - </td><td>٧٤١,٤٠٤,٨٢٢</td><td>شطب في قيمة موجودات العقود بسبب إلغاء مشاريع</td></tr>\n<tr><td>١٠,٣٨١,٩٠٠</td><td>٧,٣٣١,٣٩٠</td><td>مخصص التزامات مزايا موظفين</td></tr>\n<tr><td>(٣٠,٨٠٤,٧٥٠)</td><td>(١٨,٣٩٨,٥٨٤)</td><td>الربح من إستبعاد موجودات مصنفة كمحتفظ بها بغرض البيع</td></tr>\n<tr><td>٧٣,٨٨٨,٠٦١</td><td>٨٩,١٧٠,٦٦٧</td><td>مصاريف تمويلية</td></tr>\n<tr><td></td><td></td><td>تعديلات رأس المال العامل</td></tr>\n<tr><td>١٠,٧٨١,٦٦١</td><td>٦,١٠٦,٤٥٤</td><td>مخزون</td></tr>\n<tr><td>٣٨,٢٥٧,١٣٢</td><td>٥٤,٠٦٧,٦٥٣</td><td>الذمم المدينة التجارية والذمم المدينة الأخرى</td></tr>\n<tr><td>١٧٦,٩٥١,٨٢٧</td><td>١٦٢,٨١٣,٥٥٥</td><td>موجودات العقود</td></tr>\n<tr><td>68,432,427</td><td>49,281,652</td><td>ذمم دائنة ومدفوعات مقدمة وموجودات أخرى</td></tr>\n<tr><td>(329,897,986)</td><td>90,213,369</td><td>ذمم دائنة تجارية وذمم دائنة أخرى</td></tr>\n<tr><td>(49,648,866)</td><td>(87,492,116)</td><td>مدفوعات مقدمة من عملاء</td></tr>\n<tr><td>(13,326,610)</td><td>(37,711,959)</td><td>مخصصات ومطلوبات أخرى</td></tr>\n<tr><td>(39,192,377)</td><td>(8,715,402)</td><td>النقد المستخدم في العمليات</td></tr>\n<tr><td>(٤٨,٦٨٥,٤٥٧)</td><td>(٣٠,٥٤٤,٤٩١)</td><td>مصاريف تمويلية مدفوعة</td></tr>\n<tr><td>(٣,٣٩١,٤٥٩)</td><td></td><td>الزكاة المدفوعة</td></tr>\n<tr><td>(٦,٧٢٩,١٠٠)</td><td>(٦,٠٩٧,٤٤٦)</td><td>التزامات مزايا الموظفين المدفوعة</td></tr>\n<tr><td>(٩٧,٩٩٨,٣٩٣)</td><td>(٤٥,٣٥٧,٣٣٩)</td><td>صافي النقد المستخدم في الأنشطة التشغيلية</td></tr>\n<tr><td></td><td></td><td>التدفقات النقدية من الأنشطة الإستثمارية</td></tr>\n<tr><td>(٩,٣٠١,٥٣٦)</td><td>(٣٢٥,٥٢٨)</td><td>شراء ممتلكات ومعدات</td></tr>\n<tr><td>٧٠,٧٩٥,٨٢٣</td><td>٣٦,٩٨٧,٦٧٧</td><td>المتحصل من استبعاد موجودات مصنفة كمحتفظ بها بغرض البيع</td></tr>\n<tr><td>(١٢٧,٣٦٨)</td><td>–</td><td>شراء موجودات غير ملموسة</td></tr>\n<tr><td>٦١,٣٦٦,٩١٩</td><td>٣٦,٦٦٢,١٤٩</td><td>صافي النقد الناتج من الأنشطة الإستثمارية</td></tr>\n<tr><td></td><td></td><td>التدفقات النقدية من الأنشطة التمويلية</td></tr>\n<tr><td>(١١٢,٥٥٥,٧٧١)</td><td>(١١,٢٨٥,٣٢٩)</td><td>المسدد من القروض</td></tr>\n<tr><td>١١١,٦٧٥,٢٥٢</td><td>٤٦,٨٣٦,٥٢٥</td><td>قرض من أحد المساهمين، صافى</td></tr>\n<tr><td>(١,١٩٧,٠٥٠)</td><td>- </td><td>توزيعات أرباح مدفوعة</td></tr>\n<tr><td>(٢,٠٧٧,٥٦٩)</td><td>٣٥,٥٥١,١٩٦</td><td>صافى النقد الناتج من / (المستخدم فى) الأنشطة التمويلية</td></tr>\n<tr><td>(٣٨,٧٠٩,٠٤٣)</td><td>٢٦,٨٥٦,٠٠٦</td><td>صافى التغير فى النقد وما في حكمه</td></tr>\n<tr><td>٤٠,٩٦٣</td><td>(١٣,٨٥٢)</td><td>صافي فروق ترجمة عمليات أجنبية</td></tr>\n<tr><td>٧٣,٧٨٤,٧٤٣</td><td>٣٥,١١٦,٦٦٣</td><td>النقد وما في حكمه في بداية السنة</td></tr>\n<tr><td>٣٥,١١٦,٦٦٣</td><td>٦١,٩٥٨,٨١٧</td><td>النقد وما في حكمه في نهاية السنة</td></tr>\n<tr><td></td><td></td><td>معلومات إضافية عن المعاملات غير النقدية (ايضاح ١٢-٣)</td></tr>\n</table>\n\nتم إعتماد هذه القوائم المالية للإصدار من قبل مجلس الإدارة بتاريخ ١١ يناير ٢٠٢١ وتم توقيعها بالنيابة [SIGNATURE]\n\n\n[SIGNED]\nيعها بالنيابة عن المساهمين من قبل:-\n[HANDWRITTEN_SIGNATURE]\n[HANDWRITTEN_SIGNATURE]\nعلي آل بوصالح\nالرئيس التنفيذي\n\n\n[SIGNED]\nسهيل سعيد\nالمدير المالي\n[SIGNATURE]\n\n\n[SIGNED]\nموحدة للإصدار من قبل مجلس الإدارة بتاريخ ١١ يناير ٢٠٢١ وتم توق\nسلطان الهاجري رئيس مجلس الإدارة\nتعد الإيضاحات المرفقة جزء لا يتجزأ من هذه القوائم المالية الموحدة.\n- ٩ -\n\n\n<!-- doc_id=parse-01m40kb9177k5q4g5qpbze8m27 -->", "metadata": {"job_id": "parse-01m40kb9177k5q4g5qpbze8m27", "model_version": "dpt-3-pro-20260710", "page_count": 1, "output_markdown_chars": 4780, "range_units": "unicode_codepoints", "openapi_spec": "https://api.ade.landing.ai/openapi.json", "failed_pages": [], "duration_ms": 6858, "billing": {"service_tier": "standard", "total_credits": 1.7}}, "structure": {"children": [{"children": [{"atomic_grounding": [{"box": {"xmax": 0.89222, "xmin": 0.66661, "ymax": 0.11903, "ymin": 0.10499}, "page": 1, "range": {"end": 36, "start": 0}}, {"box": {"xmax": 0.89086, "xmin": 0.75419, "ymax": 0.13379, "ymin": 0.11921}, "page": 1, "range": {"end": 57, "start": 36}}], "grounding": {"box": {"xmax": 0.89652, "xmin": 0.663, "ymax": 0.13539, "ymin": 0.10157}, "page": 1, "range": {"end": 57, "start": 0}}, "id": "text-0", "type": "text"}, {"atomic_grounding": [{"box": {"xmax": 0.89207, "xmin": 0.72106, "ymax": 0.15181, "ymin": 0.13866}, "page": 