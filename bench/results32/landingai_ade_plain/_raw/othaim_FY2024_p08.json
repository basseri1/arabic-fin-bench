{"job_id": "parse-01m40kh1rtf64qh7m5jx1g1qyw", "status": "completed", "created_at": "2026-10-03T10:04:04.257910+00:00", "completed_at": "2026-10-03T10:04:10.733262+00:00", "result": {"markdown": "شركة أسواق عبد الله العثيم\n(شركة مساهمة سعودية)\n\n\nقائمة الدخل الموحدة\nللسنة المنتهية في ٣١ ديسمبر ٢٠٢٤ م\n\n\n<table>\n<tr><td>٢٠٢٣ م</td><td>٢٠٢٤ م</td><td>إيضاح</td><td></td></tr>\n<tr><td>(معدلة إيضاح ٣٧)</td><td></td><td></td><td></td></tr>\n<tr><td>١٠,٢٣٣,٧١٩,٤٧٤</td><td>١٠,٧١٥,٧١٦,٧١٤</td><td>٢٨</td><td>صافي المبيعات</td></tr>\n<tr><td>(٧,٩٦٤,٩٢٥,٦٨٥)</td><td>(٨,٣٠٤,٩٨٦,٣٢٨)</td><td></td><td>تكلفة المبيعات</td></tr>\n<tr><td>٢,٢٦٨,٧٩٣,٧٨٩</td><td>٢,٤١٠,٧٣٠,٣٨٦</td><td></td><td>إجمالي الربح</td></tr>\n<tr><td>٧١,٠١٤,٩٤٢</td><td>٧٩,٠٧٥,٥٠٧</td><td>٢٩</td><td>إيرادات تأجير، صافي</td></tr>\n<tr><td>٢,٥٠٠,٢٥١</td><td>١,٩٤٣,٩١٨</td><td></td><td>عمولات بيع قسائم</td></tr>\n<tr><td>(١,٧٣٩,٠٠٧,٥٨٩)</td><td>(١,٨٦٥,٦٣١,٠٩٠)</td><td>٢٥</td><td>مصاريف بيعية وتسويقية</td></tr>\n<tr><td>(١٥٨,٨٤٩,٢٨٢)</td><td>(١٧٧,٠٨١,٦٧٩)</td><td>٢٦</td><td>مصاريف إدارية وعمومية</td></tr>\n<tr><td>٤٤٤,٤٥٢,١١١</td><td>٤٤٩,٠٣٧,٠٤٢</td><td></td><td>الربح من العمليات</td></tr>\n<tr><td>٣٢,٣٣٤,٦٢٧</td><td>١٩٨,٣٨٦,٠٣٦</td><td>٩</td><td>الحصة في الربح للشركات الزميلة والمشروع المشترك، صافي</td></tr>\n<tr><td>٩٩,٤٧٥,٧٤٤</td><td>−</td><td>٣٢</td><td>مكاسب بيع عقارات استثمارية، صافي</td></tr>\n<tr><td>٢٣,٧٠٧,٨٤٣</td><td>١١,٥٥٩,٦٩٠</td><td>١٦-ب</td><td>إيرادات تمويلية وودائع وأخرى</td></tr>\n<tr><td>(١١٣,٢٥٩,٧٩٦)</td><td>(١٦,٣٣٢,٧١٠)</td><td>٣٣</td><td>تكاليف تمويل</td></tr>\n<tr><td>٤,٠٦٨,٠٥٧</td><td>−</td><td>٥</td><td>عكس خسائر هبوط في عقارات وآلات ومعدات</td></tr>\n<tr><td>١٤,٥٧٩,٤٦٨</td><td>١٧,٠٤٧,٤٤٩</td><td>٣٥</td><td>إيرادات أخرى، صافي</td></tr>\n<tr><td>٥٠٥,٣٥٨,٠٥٤</td><td>٥١٥,٦٩٧,٥٠٧</td><td></td><td>الربح قبل الزكاة والضريبة الأجنبية</td></tr>\n<tr><td>(١٧,٥٧٤,٩٢٨)</td><td>(١٧,٠٥٦,٩٨٣)</td><td>٢٤</td><td>الزكاة والضريبة الأجنبية</td></tr>\n<tr><td>٨٠٠,٠٣٨</td><td>١٧,٦٩٢,٥٩٢</td><td>٢٤</td><td>عكس قيد زكاة متعلقة بسنوات سابقة</td></tr>\n<tr><td>٤٨٨,٥٨٣,١٦٤</td><td>٥١٦,٣٣٣,١١٦</td><td></td><td>ربح السنة</td></tr>\n<tr><td></td><td></td><td></td><td>الربح العائد إلى</td></tr>\n<tr><td>٤٨٢,٠٤٧,٧٢٩</td><td>٥١١,٠٢١,٩٩٢</td><td></td><td>مساهمي الشركة الأم</td></tr>\n<tr><td>٦,٥٣٥,٤٣٥</td><td>٥,٣١١,١٢٤</td><td></td><td>حقوق الملكية غير المسيطرة</td></tr>\n<tr><td>٤٨٨,٥٨٣,١٦٤</td><td>٥١٦,٣٣٣,١١٦</td><td></td><td></td></tr>\n<tr><td>٠,٥٤</td><td>٠,٥٧</td><td>٢٧</td><td>ربحية السهم<br>ربحية السهم الأساسية والمخفضة من ربح للسنة العائد لمساهمي الشركة</td></tr>\n</table>\n\n[SIGNED]\n[ILLEGIBLE_SIGNATURE]\n\n\n[SIGNED]\n[HANDWRITTEN_SIGNATURE]\nرئيس مجلس الإدارة\nعبدالله العثيم\n[HANDWRITTEN_SIGNATURE]\nالرئيس التنفيذي\nموفق عبد الله مباره\n\n\nالرئيس التنفيذي للشؤون المالية\nمروان أحمد إبراهيم\n\n\nإن الإيضاحات المرفقة من (١) إلى (٣٩) تشكل جزءاً لا يتجزأ من هذه القوائم المالية الموحدة.\n\n\n٧\n\n\n<!-- doc_id=parse-01m40kh1rtf64qh7m5jx1g1qyw -->", "metadata": {"job_id": "parse-01m40kh1rtf64qh7m5jx1g1qyw", "model_version": "dpt-3-pro-20260710", "page_count": 1, "output_markdown_chars": 2702, "range_units": "unicode_codepoints", "openapi_spec": "https://api.ade.landing.ai/openapi.json", "failed_pages": [], "duration_ms": 5730, "billing": {"service_tier": "standard", "total_credits": 1.2}}, "structure": {"children": [{"children": [{"atomic_grounding": [{"box": {"xmax": 0.90636, "xmin": 0.71156, "ymax": 0.05283, "ymin": 0.03483}, "page": 1, "range": {"end": 27, "start": 0}}, {"box": {"xmax": 0.90605, "xmin": 0.73114, "ymax": 0.06891, "ymin": 0.05265}, "page": 1, "range": {"end": 48, "start": 27}}], "grounding": {"box": {"xmax": 0.91134, "xmin": 0.70627, "ymax": 0.06902, "ymin": 0.03129}, "page": 1, "range": {"end": 48, "start": 0}}, "id": "text-0", "type": "text"}, {"atomic_grounding": [{"box": {"xmax": 0.90696, "xmin": 0.78023, "ymax": 0.08616, "ymin": 0.07287}, "page": 1, "range": {"end": 70, "start": 50}}, {"box": {"xmax": 0.9071, "xmin": 0.70532, "ymax": 0.1043, "ymin