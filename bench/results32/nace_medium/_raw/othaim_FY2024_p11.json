٤٢)</td><td>(١٦,٧٧٩,٦١٤)</td></tr><tr><td>٦٨١,٠٩٢,٨٧٩</td><td>٩١٠,٢٦٩,٤٥١</td></tr><tr><td>٢,٧٨٨,١٢٢</td><td>٣,٢٨٤,٧٤٤</td></tr><tr><td>١٨٦,٥٦٨,٧٠٤</td><td>-</td></tr><tr><td>-</td><td>٩٠,٠٠٠,٠٠٠</td></tr><tr><td>٣٤,٩٣٢,٠٠٠</td><td>٣٦,٦٨٢,٠٠٠</td></tr><tr><td>١٧,٤٨٤,١٣٢</td><td>٨,١٠٧,٥٣٢</td></tr><tr><td>(٣٨٤,٩٧٠,٥٩٠)</td><td>(٥٩٠,٧٧٨,٧٦٨)</td></tr><tr><td>(٢٢٤,٢٤٤,١٤٥)</td><td>(٤٩,٧٢١,٢٢٢)</td></tr><tr><td>(١,٣٦٩,٠٧٩)</td><td>(١,٤٩٨,٤٩٣)</td></tr><tr><td>(٦٩١,٥٣٧,٥٠٠)</td><td>(٢٧٩,٤٨٨,٧٢٣)</td></tr><tr><td>١,٠٣١,٥٣٧,٥٠٠</td><td>٢٩٤,٠٠٠,٠٠٠</td></tr><tr><td>(٢٨,٨١٠,٨٥٦)</td><td>(٤٨٩,٤١٢,٩٣٠)</td></tr></tbody></table>\n\n# **التدفقات النقدية من الأنشطة التشغيلية**\n\nالربح قبل الزكاة والضريبة الأجنبية\n\n# **تسويات ك:**\n\n- استهلاك عقارات وآلات ومعدات وأصول حق الاستخدام\n- استهلاك عقارات استثمارية\n- إطفاء أصول غير ملموسة\n- (مكاسب) خسائر بيع عقارات وآلات ومعدات\n- عكس خسائر هبوط في عقارات وآلات ومعدات\n- (مكاسب) خسائر تصفية التزامات عقود إيجار\n- مكاسب بيع عقارات استثمارية\n- تكاليف تمويل\n- إيرادات تمويلية وودائع وأخرى\n- الحصة في الخسارة للشركات الزميلة والمشروع المشترك، صافي\n- مخصص (عكس قيد مخصص) تقلص المخزون والمخزون بطيء الحركة\n- مخصص (عكس قيد مخصص) خسائر ائتمانية متوقعة\n- مخصص قضايا وأخرى\n- التزام مكافآت نهاية الخدمة للموظفين\n\n# **التغيرات في:**\n\n- المخزون\n- ذمم مدينة تجارية\n- دفعات مقدمة وأصول متداولة أخرى\n- ذمم دائنة\n- مصاريف مستحقة والتزامات متداولة أخرى\n\nمكافأة نهاية الخدمة المدفوعة للموظفين\nزكاة وضريبة أجنبية مدفوعة\n\n**صافي التدفقات النقدية الناتجة من الأنشطة التشغيلية**\n\n# **التدفقات النقدية المستخدمة في الأنشطة الاستثمارية**\n\n- المتحصل من بيع عقارات وآلات ومعدات\n- المتحصل من بيع عقارات استثمارية\n- توزيعات من شركات زميلة ومشروع مشترك\n- دفعات إيجار تمويلي مستلمة\n- إيرادات ودائع وأخرى مستلمة\n- إضافات إلى عقارات وآلات ومعدات\n- إضافات إلى عقارات استثمارية\n- إضافات إلى أصول غير ملموسة\n- استثمارات وودائع مرابحة قصيرة الأجل\n- المسترد من استثمارات وودائع مرابحة قصيرة الأجل\n- **صافي التدفقات النقدية المستخدمة في الأنشطة الاستثمارية**\n\nإن الإيضاحات المرفقة من (١) إلى (٣٩) تشكل جزءاً لا يتجزأ من هذه القوائم المالية الموحدة.\n\n١٠", "content_url": null, "text": null, "blocks": [{"id": "blk_1_1", "type": "heading", "content": "# **شركة أسواق عبد الله العثيم**\n**(شركة مساهمة سعودية)**", "sheet_name": null, "source_id": null, "source_name": null, "image_anchor": null, "markdown_span": {"kind": "text_span", "page": 1, "char_start": 0, "char_end": 57}, "table_row_offset": 0, "location": {"kind": "page_region", "page": 1, "polygons": [[[0.7037484885126964, 0.034202650705429674], [0.9129383313180169, 0.034202650705429674], [0.9129383313180169, 0.06926036767849508], [0.7037484885126964, 0.06926036767849508]]]}, "confidence": null, "image_url": null}, {"id": "blk_1_2", "type": "heading", "content": "# **قائمة التدفقات النقدية الموحدة**\n**للسنة المنتهية في ٣١ ديسمبر ٢٠٢٤ م**", "sheet_name": null, "source_id": null, "source_name": null, "image_anchor": null, "markdown_span": {"kind": "text_span", "page": 1, "char_start": 59, "char_end": 134}, "table_row_offset": 0, "location": {"kind": "page_region", "page": 1, "polygons": [[[0.6989117291414753, 0.07097050021376657], [0.9129383313180169, 0.07097050021376657], [0.9129383313180169, 0.10517315091919624], [0.6989117291414753, 0.10517315091919624]]]}, "confidence": null, "image_url": null}, {"id": "blk_1_3", "type": "table", "content": "<table><thead><tr><th>٢٠٢٣ م إيضاح</th><th>٢٠٢٤ م إيضاح</th></tr></thead><tbody><tr><td>(معللة إيضاح ٣٧)</td><td></td></tr><tr><td>٥٠٥,٣٥٨,٠٥٤</td><td>٥١٥,٦٩٧,٥٠٧</td></tr><tr><td>٣٦٨,٨٧٢,٨٤٥</td><td>٤٠٥,٠٨١,٦٠٥</td></tr><tr><td>٨,٥٧٩,٩٢١</td><td>٥,٧٢٩,٢٧٩</td></tr><tr><td>٦٣٣,٠٣٦</td><td>٥٣٦,٥٣١</td></tr><tr><td>٣,٤١١,٠٠٩</td><td>(٦٧١,٣٠٦)</td></tr><tr><td>(٤,٠٦٨,٠٥٧)</td><td>-</td></tr><tr><td>١,٠١٨,٦٣٢</td><td>(٦,٠٢٢,٢٤٥)</td></tr><tr><td>(٩٩,٤٧٥,٧٤٤)</td><td>-</td></tr><tr><td>١١٣,٢٥٩,٧٩٦</td><td>١٦٠,٣٣٢,٧١٠</td></tr><tr><td>(٢٣,٧٠٧,٨٤٣)</td><td>(١١,٥٥٩,٦٩٠)</td></tr><tr><td>(٣٢,٣٣٤,٦٢٧)</td><td>(١٩٨,٣٨٦,٠٣٦)</td></tr><t