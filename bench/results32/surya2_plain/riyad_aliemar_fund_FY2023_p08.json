[{"label": "Text", "bbox": [860.08, 198.73000000000002, 1467.098, 378.75600000000003], "html": "<p>صندوق الرياض للإعمار<br/>\n    صندوق استثماري مفتوح<br/>\n    (مدار من قبل شركة الرياض المالية)<br/>\n    قائمة التغيرات في حقوق الملكية العائدة إلى حاملي الوحدات<br/>\n    (المبالغ بالريالات السعودية ما لم يذكر غير ذلك)</p>"}, {"label": "SectionHeader", "bbox": [256.37, 411.488, 568.976, 453.572], "html": "<p><b>للسنة المنتهية في ٣١ ديسمبر</b></p>"}, {"label": "Text", "bbox": [256.37, 451.23400000000004, 568.976, 483.96599999999995], "html": "<p>٢٠٢٣</p>"}, {"label": "Text", "bbox": [244.792, 519.0360000000001, 640.0980000000001, 556.444], "html": "<p>١٤,٥٥٢,٨٦٧ ١٢,١٠٧,٣٩١</p>"}, {"label": "Text", "bbox": [249.754, 589.176, 641.7520000000001, 631.26], "html": "<p>(٢,٦٨٨,٠٠٣) ٣,٣٦٣,٤٦٥</p>"}, {"label": "Text", "bbox": [873.312, 519.0360000000001, 1448.904, 558.7819999999999], "html": "<p>حقوق الملكية العائدة إلى حاملي الوحدات في بداية السنة</p>"}, {"label": "Text", "bbox": [1022.172, 586.838, 1448.904, 628.922], "html": "<p>مجموع الدخل / (الخسارة) الشاملة للسنة</p>"}, {"label": "Text", "bbox": [946.088, 656.9780000000001, 1448.904, 699.062], "html": "<p>الاشتراكات والاستردادات من قبل حاملي الوحدات</p>"}, {"label": "Text", "bbox": [1273.58, 696.7239999999999, 1448.904, 734.132], "html": "<p>إصدار الوحدات</p>"}, {"label": "Text", "bbox": [1265.31, 729.456, 1448.904, 769.202], "html": "<p>استرداد الوحدات</p>"}, {"label": "Text", "bbox": [1088.332, 764.5260000000001, 1448.904, 806.6099999999999], "html": "<p>صافي التغير من معاملات الوحدات</p>"}, {"label": "Table", "bbox": [173.67, 692.048, 653.33, 806.6099999999999], "html": "<table border=\"1\">\n<tr>\n<td>٧,٢٩٥,٠٦٤</td>\n<td>١,٨٣١,٦٨٨</td>\n</tr>\n<tr>\n<td>(٧,٠٥٢,٥٣٧)</td>\n<td>(٨,٥١٩,٩٨٧)</td>\n</tr>\n<tr>\n<td>٢٤٢,٥٢٧</td>\n<td>(٦,٦٨٨,٢٩٩)</td>\n</tr>\n</table>"}, {"label": "Text", "bbox": [244.792, 837.004, 651.676, 876.75], "html": "<p>١٢,١٠٧,٣٩١ ٨,٧٨٢,٥٥٧</p>"}, {"label": "Text", "bbox": [871.658, 837.004, 1448.904, 879.088], "html": "<p>حقوق الملكية العائدة إلى حاملي الوحدات في نهاية السنة</p>"}, {"label": "Text", "bbox": [615.288, 911.82, 1467.098, 953.9039999999999], "html": "<p>تعتبر الإيضاحات المرفقة من رقم ١ إلى رقم ١٧ جزءاً لا يتجزأ من هذه القوائم المالية.</p>"}, {"label": "PageFooter", "bbox": [803.8439999999999, 2237.466, 827.0, 2267.86], "html": "<p>٦</p>"}]