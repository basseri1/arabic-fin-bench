[{"label": "SectionHeader", "bbox": [1162.762, 79.52600000000001, 1511.756, 161.39100000000002], "html": "<p>شركة أسواق عبد الله العثيم<br/>(شركة مساهمة سعودية)</p>"}, {"label": "Text", "bbox": [1281.8500000000001, 168.408, 1511.756, 203.493], "html": "<p>قائمة الدخل الموحدة</p>"}, {"label": "Text", "bbox": [1152.838, 208.171, 1511.756, 245.595], "html": "<p>للسنة المنتهية في ٣١ ديسمبر ٢٠٢٤م</p>"}, {"label": "Table", "bbox": [165.4, 287.697, 783.996, 1433.807], "html": "<table border=\"1\">\n<thead>\n<tr>\n<th>ايضاح</th>\n<th>٢٠٢٤م<br/>٣٤</th>\n<th>٢٠٢٣م<br/>٣٤</th>\n</tr>\n<tr>\n<th></th>\n<th>معدلة ايضاح (٣٧)</th>\n<th></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>صافي المبيعات<br/>تكلفة المبيعات<br/>إجمالي الربح</td>\n<td>٢٨</td>\n<td>١٠,٧١٥,٧١٦,٧١٤<br/>(٨,٣٠٤,٩٨٦,٣٢٨)<br/>٢,٤١٠,٧٣٠,٣٨٦</td>\n</tr>\n<tr>\n<td>إيرادات تأجير، صافي<br/>عمولات بيع قسائم<br/>مصاريف بيعية وتسويقية<br/>مصاريف إدارية وعمومية<br/>الربح من العمليات</td>\n<td>٢٩</td>\n<td>٧٩,٠٧٥,٥٠٧<br/>١,٩٤٣,٩١٨<br/>(١,٨٦٥,٦٣١,٠٩٠)<br/>(١٧٧,٠٨١,٦٧٩)<br/>٤٤٩,٠٣٧,٠٤٢</td>\n</tr>\n<tr>\n<td>الحصة في الربح للشركات الزميلة والمشروع المشترك، صافي<br/>مكاسب بيع عقارات استثمارية، صافي<br/>إيرادات تمويلية وودائع وأخرى<br/>تكاليف تمويل<br/>عكس خسائر هبوط في عقارات وآلات ومعدات<br/>إيرادات أخرى، صافي<br/>الربح قبل الزكاة والضريبة الأجنبية</td>\n<td>٩</td>\n<td>١٩٨,٣٨٦,٠٣٦</td>\n</tr>\n<tr>\n<td></td>\n<td>٣٢</td>\n<td>-</td>\n</tr>\n<tr>\n<td></td>\n<td>١٦-ب</td>\n<td>١١,٥٥٩,٦٩٠</td>\n</tr>\n<tr>\n<td></td>\n<td>٣٣</td>\n<td>(١٦٠,٣٣٢,٧١٠)</td>\n</tr>\n<tr>\n<td></td>\n<td>٥</td>\n<td>-</td>\n</tr>\n<tr>\n<td></td>\n<td>٣٥</td>\n<td>١٧,٠٤٧,٤٤٩</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>٥١٥,٦٩٧,٥٠٧</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>٥٠٥,٣٥٨,٠٥٤</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>(١٧,٠٥٦,٩٨٣)</td>\n</tr>\n<tr>\n<td></td>\n<td>٢٤</td>\n<td>١٧,٦٩٢,٥٩٢</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>٤٨٨,٥٨٣,١٦٤</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td>الربح العائد إلى<br/>مساهمي الشركة الأم<br/>حقوق الملكية غير المسيطرة</td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>٤٨٢,٠٤٧,٧٢٩</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>٦,٥٣٥,٤٣٥</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>٤٨٨,٥٨٣,١٦٤</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td>ربحية السهم</td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td>ربحية السهم الأساسية والمخفضة من ربح للسنة العائد لمساهمي الشركة</td>\n<td>٢٧</td>\n<td>٠,٥٧</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>٠,٥٤</td>\n</tr>\n</tbody>\n</table>"}, {"label": "Text", "bbox": [221.63600000000002, 1922.658, 545.82, 2053.642], "html": "<img/>"}, {"label": "Text", "bbox": [282.834, 2020.896, 474.698, 2060.659], "html": "<p>رئيس مجلس الإدارة</p>"}, {"label": "Text", "bbox": [279.526, 2067.676, 474.698, 2105.1], "html": "<p>عبدالله صالح العثيم</p>"}, {"label": "Text", "bbox": [712.874, 1861.844, 927.8940000000001, 2009.201], "html": "<img/>"}, {"label": "Text", "bbox": [740.992, 2020.896, 904.738, 2058.32], "html": "<p>الرئيس التنفيذي</p>"}, {"label": "Text", "bbox": [727.76, 2067.676, 916.316, 2105.1], "html": "<p>موفق عبد الله مباره</p>"}, {"label": "Text", "bbox": [1113.142, 1845.471, 1455.52, 1967.099], "html": "<img/>"}, {"label": "Text", "bbox": [1111.488, 2020.896, 1427.402, 2058.32], "html": "<p>الرئيس التنفيذي للشؤون المالية</p>"}, {"label": "Text", "bbox": [1166.07, 2067.676, 1367.858, 2105.1], "html": "<p>مروان أحمد إبراهيم</p>"}, {"label": "PageFooter", "bbox": [439.964, 2198.66, 1205.766, 2238.423], "html": "<p>إن الإيضاحات المرفقة من (١) إلى (٣٩) تشكل جزءاً لا يتجزأ من هذه القوائم المالية الموحدة.</p>"}, {"label": "PageFooter", "bbox": [813.768, 2243.101, 833.616, 2271.169], "html": "<p>٧</p>"}]