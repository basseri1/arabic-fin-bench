[{"label": "SectionHeader", "bbox": [1127.736, 126.306, 1473.84, 166.069], "html": "<p>صندوق سدكو كابيتال ريت</p>"}, {"label": "Text", "bbox": [1119.4560000000001, 168.408, 1473.84, 212.849], "html": "<p>(مدار من قبل سدكو كابيتال)</p>"}, {"label": "Text", "bbox": [1235.376, 215.188, 1473.84, 252.612], "html": "<p>قائمة التدفقات النقدية</p>"}, {"label": "Text", "bbox": [1073.088, 252.612, 1473.84, 292.375], "html": "<p>للسنة المنتهية في ٣١ ديسمبر ٢٠٢٢م</p>"}, {"label": "Text", "bbox": [226.872, 290.036, 766.7280000000001, 364.884], "html": "<p>ايضاح ريال سعودي ٢٠٢٢م<br/>ريال سعودي ٢٠٢١م</p>"}, {"label": "Text", "bbox": [241.77599999999998, 399.96900000000005, 1473.84, 479.49499999999995], "html": "<p>الأنشطة التشغيلية<br/>صافي دخل / (خسارة) السنة<br/>(٣٥,٤٣٧,٧٧٥) ٤١,١١٠,٣٤٤</p>"}, {"label": "Text", "bbox": [836.28, 509.902, 1473.84, 584.75], "html": "<p>تعديلات لتسوية صافي الدخل/(الخسارة) إلى صافي النقد من<br/>الأنشطة التشغيلية:</p>"}, {"label": "Text", "bbox": [253.368, 584.75, 745.2, 701.6999999999999], "html": "<p>١٦,١٩٤,٦٣٨ ٢٩,١٣٠,٤٤٩ ٥<br/>٢٤٩,٨٣٢ ٣,٥٠٠,٠٠٠ ١-٧<br/>٦٠,١٤٧,٧١٩ ٢٦,٨٣٩,٨١٦ ٥</p>"}, {"label": "Text", "bbox": [799.848, 584.75, 1473.84, 806.9549999999999], "html": "<p>استهلاك<br/>خسائر الانتمان المتوقعة للدمم المدينة المتعلقة بالإيجارات<br/>الانخفاض في القيمة للعقارات الاستثمارية<br/>صافي مكسب/(خسارة) عن أدوات مشتقة بالقيمة العادلة من خلال<br/>قائمة الدخل<br/>أتعاب تمويلية ورسوم بنكية</p>"}, {"label": "Text", "bbox": [241.77599999999998, 725.09, 745.2, 806.9549999999999], "html": "<p>١,٢٣١,٤٥٤ (٢١,١٩٩,٢٤١)<br/>١٢,٤٨٠,٢٩٣ ٣٤,٥٢٥,٨٦٦ ٩</p>"}, {"label": "Text", "bbox": [253.368, 837.362, 745.2, 877.125], "html": "<p>٥٤,٨٦٦,١٦١ ١١٣,٩٠٧,٢٣٤</p>"}, {"label": "Text", "bbox": [241.77599999999998, 912.21, 745.2, 1181.195], "html": "<p>(١١,٨٣٠,٩٢٠) (٥,٥٧٦,٩٣٥)<br/>١,٠٩٠,٥٦٦ (١,١٠٥,٩٢٠)<br/>(٣,٣٨٦,٨٣٨) ٤٠٥,٩٣٣<br/>(٨,٢١٢,٣٥٧) (١٣,٠٩٧,٠٨٨)<br/>(٢,٤١٥,٠٨٥) ١٠,٨٢٢,٣٩٢<br/>٢,٩٠٦,٢٥٨ (٣٥,٩٣٨,٨٩٧)<br/>١٣,٧٥٠,٥٦٧ (٣,٧٩٠,٣٤٦)</p>"}, {"label": "Text", "bbox": [241.77599999999998, 1204.585, 745.2, 1251.365], "html": "<p>٤٦,٧٦٨,٣٥٢ ٦٥,٦٢٦,٣٧٣</p>"}, {"label": "Text", "bbox": [902.5200000000001, 877.125, 1473.84, 1181.195], "html": "<p>صافي التغيرات في الموجودات والمطلوبات التشغيلية:<br/>إيجار مستحق الاستلام<br/>مبالغ مدفوعة مقدما ودمم مدينة أخرى<br/>أدوات مشتقة بالقيمة العادلة من خلال قائمة الدخل<br/>الحركة في تسهيل تمويلي من بنك<br/>مستحق إلى جهة ذات علاقة<br/>مصروفات مستحقة الدفع ودمم دائنة أخرى<br/>إيرادات مؤجلة</p>"}, {"label": "Text", "bbox": [241.77599999999998, 1204.585, 745.2, 1251.365], "html": "<p>٤٦,٧٦٨,٣٥٢ ٦٥,٦٢٦,٣٧٣</p>"}, {"label": "Text", "bbox": [241.77599999999998, 1286.45, 745.2, 1415.095], "html": "<p>(٣٤٠,٧٦٥,٦٢٤) (١٧٨,٤٥٤,٧٩٦)<br/>(٦,١٦٥,٧٠٨) (٣,٩٣٢,٦٨٤)</p>"}, {"label": "Text", "bbox": [241.77599999999998, 1426.79, 745.2, 1485.265], "html": "<p>(٣٤٦,٩٣١,٣٣٢) (١٨٢,٣٨٧,٤٨٠)</p>"}, {"label": "Text", "bbox": [241.77599999999998, 1520.3500000000001, 745.2, 1695.7749999999999], "html": "<p>٢٥٠,٠٠٠,٠٠٠ - ١٤<br/>(٧,٨١٨,٨٧٦) (٨٢١,٨٦٣,٦٩٠)<br/>(٣٥,٥٥٠,٠٠٠) (٧١,٨٧٨,١٢٥) ١٠<br/>١٣٥,٠٠٠,٠٠٠ ٩٧٥,٠٠٠,٠٠٠</p>"}, {"label": "Text", "bbox": [241.77599999999998, 1719.165, 745.2, 1765.945], "html": "<p>٣٤١,٦٣١,١٢٤ ٨١,٢٥٨,١٨٥</p>"}, {"label": "Text", "bbox": [241.77599999999998, 1789.335, 745.2, 1836.115], "html": "<p>٤١,٤٦٨,١٤٤ (٣٥,٥٠٢,٩٢٢)</p>"}, {"label": "Text", "bbox": [241.77599999999998, 1859.505, 745.2, 1906.2849999999999], "html": "<p>٢٠,٥٨٥,٦٩٨ ٦٢,٠٥٣,٨٤٢</p>"}, {"label": "Text", "bbox": [241.77599999999998, 1929.675, 745.2, 1976.455], "html": "<p>٦٢,٠٥٣,٨٤٢ ٢٦,٥٥٠,٩٢٠</p>"}, {"label": "Text", "bbox": [241.77599999999998, 2046.625, 745.2, 2140.185], "html": "<p>٣٣,٠٠٣,٦٢٥ - ١٢<br/>٣٢٥,٠٠٠,٠٠٠ - ١٤</p>"}, {"label": "Text", "bbox": [1117.8000000000002, 1204.585, 1473.84, 1251.365], "html": "<p>صافي النقد من الأنشطة التشغيلية</p>"}, {"label": "Text", "bbox": [1117.8000000000002, 1286.45, 1473.84, 1403.3999999999999], "html": "<p>الأنشطة الاستثمارية<br/>مدفوعات لاستحواذ عقارات استثمارية<br/>مدفوعات للأعمال قيد التنفيذ</p>"}, {"label": "Text", "bbox": [1117.8000000000002, 1426.79, 1473.84, 1485.265], "html": "<p>صافي النقد المستخدم في الأنشطة الاستثمارية</p>"}, {"label": "Text", "bbox": [1117.8000000000002, 1496.96, 1473.84, 1695.7749999999999], "html": "<p>الأنشطة التمويلية<br/>متحصلات من اصدار وحدات جديدة<br/>سداد أصل مبلغ القرض والفائدة<br/>توزيعات أرباح مدفوعة خلال السنة<br/>متحصلات من قروض وسلف</p>"}, {"label": "Text", "bbox": [1117.8000000000002, 1719.165, 1473.84, 1765.945], "html": "<p>صافي النقد من الأنشطة التمويلية</p>"}, {"label": "Text", "bbox": [1117.8000000000002, 1789.335, 1473.84, 1836.115], "html": "<p>صافي التغير في النقد وما في حكمه</p>"}, {"label": "Text", "bbox": [1117.8000000000002, 1859.505, 1473.84, 1906.2849999999999], "html": "<p>النقد وما في حكمه في بداية السنة</p>"}, {"label": "Text", "bbox": [1117.8000000000002, 1929.675, 1473.84, 1976.455], "html": "<p>النقد وما في حكمه في نهاية السنة</p>"}, {"label": "Text", "bbox": [1117.8000000000002, 1999.845, 1473.84, 2140.185], "html": "<p>معاملات غير نقدية<br/>ضريبة التصرفات العقارية<br/>مساهمات عينية</p>"}, {"label": "Text", "bbox": [24.84, 2140.185, 488.52, 2303.915], "html": "<p>S. Ak AW<br/>AT</p>"}, {"label": "PageFooter", "bbox": [803.16, 2163.5750000000003, 1473.84, 2233.745], "html": "<p>تشكل الإيضاحات المرفقة من ١ إلى ١٩ جزءاً لا يتجزأ من هذه القوائم المالية.<br/>٨</p>"}]