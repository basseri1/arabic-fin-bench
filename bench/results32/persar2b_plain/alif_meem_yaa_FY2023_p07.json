مة التزام المنافع المحددة"}, {"bbox": [286, 1485, 432, 1524], "text": "(٤٩٨،٨٦٣)"}, {"bbox": [550, 1486, 678, 1518], "text": "۲۹۴،۱۸۲"}, {"bbox": [1004, 1484, 1443, 1528], "text": "الربح / (الخسارة) الشاملة الأخرى للسنة"}, {"bbox": [263, 1528, 432, 1562], "text": "۲۶،۱۸۵،۲۹۳"}, {"bbox": [500, 1528, 677, 1561], "text": "۳۳،۸۰۹،۴۰۲"}, {"bbox": [1148, 1531, 1444, 1574], "text": "إجمالي الدخل الشامل للسنة"}, {"bbox": [1293, 1608, 1447, 1651], "text": "ربحية السهم:"}, {"bbox": [360, 1648, 432, 1685], "text": "۳,۸۱"}, {"bbox": [604, 1650, 678, 1684], "text": "۴,۷۹"}, {"bbox": [736, 1656, 781, 1688], "text": "۲۴"}, {"bbox": [902, 1656, 1444, 1696], "text": "ربحية السهم الأساسية والمخفضة (بالرِّيال السعודי)"}, {"bbox": [374, 2078, 1282, 2119], "text": "تعتبر الإيضاحات المرفقة من رقم ١ إلى رقم ٣٣ جزءًا لا يتجزأ من هذه القوائم المالية."}, {"bbox": [820, 2202, 834, 2219], "text": "۶"}]