[{"bbox": [1265, 135, 1481, 204], "text": "بتك الحِزيرة"}, {"bbox": [1459, 185, 1470, 195], "text": "٢١"}, {"bbox": [1192, 200, 1471, 240], "text": "(شركة مساهمة سعودية)"}, {"bbox": [1147, 241, 1473, 279], "text": "قائمة الدخل الشامل الموحدة"}, {"bbox": [842, 281, 1476, 325], "text": "للسنتين المنتهيتين في ٣١ ديسمبر ٢٠٢٤م و٢٠٣٣م"}, {"bbox": [326, 385, 414, 429], "text": "2022"}, {"bbox": [528, 387, 616, 428], "text": "۲۲۰۲۴"}, {"bbox": [271, 421, 415, 460], "text": "بآلاف الريالات"}, {"bbox": [478, 422, 617, 459], "text": "بآلاف الريالات"}, {"bbox": [647, 426, 719, 464], "text": "إيضاح"}, {"bbox": [325, 456, 416, 495], "text": "السعودية"}, {"bbox": [529, 458, 620, 494], "text": "السعودية"}, {"bbox": [280, 522, 410, 557], "text": "۱،۰۱۹،۹۷۲"}, {"bbox": [482, 524, 611, 555], "text": "١،٢٣،٩٥٤"}, {"bbox": [1297, 522, 1473, 561], "text": "صافي الدخل للسنة"}, {"bbox": [1229, 589, 1465, 627], "text": "الخسارة الشاملة الأخرى:"}, {"bbox": [805, 655, 1460, 695], "text": "بنود سيتم إعادة تصنيفها إلى قائمة الدخل الموحدة في السنوات اللاحقة:"}, {"bbox": [1244, 726, 1473, 757], "text": "تحويلات التدفقات النقدية:"}, {"bbox": [294, 754, 409, 793], "text": "(٤,٨٢٨)"}, {"bbox": [520, 758, 612, 787], "text": "١٧،١٧٨"}, {"bbox": [664, 756, 705, 789], "text": "۱۸"}, {"bbox": [1050, 757, 1412, 793], "text": "الجزء الفعال من التخير في القيمة العادلة"}, {"bbox": [329, 786, 413, 833], "text": "(17)"}, {"bbox": [496, 787, 616, 829], "text": "(١،١٤٩)"}, {"bbox": [665, 791, 703, 822], "text": "۱۸"}, {"bbox": [943, 792, 1410, 825], "text": "صافي المبلغ المعاد تصنيفه إلى قائمة الدخل الموحدة"}, {"bbox": [783, 824, 1470, 860], "text": "صافي التغيرات في القيمة العادلة لاستثمارات مصنفة بالقيمة العادلة من خلال"}, {"bbox": [292, 853, 411, 896], "text": "(٧٠،٣٧٩)"}, {"bbox": [481, 855, 615, 894], "text": "(٣٧٨, ٣٦٧)"}, {"bbox": [665, 857, 703, 887], "text": "۱۸"}, {"bbox": [1220, 858, 1458, 893], "text": "الدخل الشامل الآخر - دين"}, {"bbox": [796, 921, 1465, 961], "text": "بنود لن يتم إعادة تصنيفها إلى قائمة الدخل الموحدة في السنوات اللاحقة."}, {"bbox": [781, 989, 1471, 1024], "text": "صافي التغيرات في الفيصة العادلة لاستئنارات مصنفة بالقيمة العادلة من خلال"}, {"bbox": [315, 1021, 406, 1053], "text": "۲۲,۴۷۴"}, {"bbox": [516, 1021, 613, 1053], "text": "۸۹,۱۱۵"}, {"bbox": [664, 1022, 702, 1052], "text": "۱۸"}, {"bbox": [1151, 1026, 1456, 1053], "text": "الدخل الشامل الآخر - حقوق ملكية"}, {"bbox": [328, 1054, 406, 1087], "text": "۷،۰۷۶"}, {"bbox": [495, 1051, 616, 1093], "text": "(١٧،٦٨٥)"}, {"bbox": [664, 1055, 702, 1086], "text": "١٨"}, {"bbox": [1013, 1057, 1468, 1090], "text": "(خسائر) / مكاسب إعادة قياس التزام منافع موظفين"}, {"bbox": [328, 1084, 409, 1124], "text": "٩،٨٢٣"}, {"bbox": [556, 1086, 615, 1120], "text": "٩٨٤"}, {"bbox": [1079, 1090, 1467, 1122], "text": "حصة في الدخل الشامل الآخر لشركة زميلة"}, {"bbox": [292, 1154, 408, 1195], "text": "(٧٢،٩٤١)"}, {"bbox": [478, 1153, 612, 1193], "text": "(٧٤٨،٩٧٤)"}, {"bbox": [1115, 1151, 1471, 1192], "text": "إجمالي الخسارة الشاملة الأخرى للسنة"}, {"bbox": [300, 1221, 404, 1253], "text": "۹۴۷،۰۳۱"}, {"bbox": [502, 1221, 609, 1253], "text": "۹۸۲،۰۳۰"}, {"bbox": [1216, 1218, 1472, 1259], "text": "إجمالي الدخل الشامل للسنة"}, {"bbox": [220, 1482, 555, 1640], "text": "۱۸۲"}, {"bbox": [352, 1623, 470, 1667], "text": "هاني نوري"}, {"bbox": [745, 1619, 914, 1663], "text": "نايف العبد الكريم"}, {"bbox": [1125, 1625, 1375, 1659], "text": "المهندس عبدالمجيد السلطان"}, {"bbox": [310, 1654, 515, 1697], "text": "المسؤول المالي الأول"}, {"bbox": [675, 1659, 972, 1693], "text": "الرئيس التنفيذي والعضو المنتدب"}, {"bbox": [1155, 1661, 1346, 1695], "text": "رئيس مجلس الإدارة"}, {"bbox": [117, 2074, 303, 2279], "text": "۲۸۸"}, {"bbox": [768, 2138, 1466, 2170], "text": "تعتبر الإيضاحات المرفقة من ١ إلى ٤٥ جزءًا لا يتجزأ من هذه القوائم المالية الموحدة."}, {"bbox": [828, 2175, 844, 2197], "text": "۹"}]