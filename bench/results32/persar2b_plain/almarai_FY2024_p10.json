[{"bbox": [775, 88, 905, 124], "text": "شركة المراعي"}, {"bbox": [742, 123, 938, 150], "text": "شركة مساهمة سعودية"}, {"bbox": [720, 149, 959, 180], "text": "قائمة الدخل الشامل الموحدة"}, {"bbox": [671, 179, 1008, 213], "text": "اللسنة الممنهية في ٣١ ديسمبر ٢٠٢٤م"}, {"bbox": [359, 239, 520, 279], "text": "للسنة المنتهية في"}, {"bbox": [274, 276, 376, 308], "text": "۳۱ دیسمبر"}, {"bbox": [498, 274, 601, 308], "text": "۳۱ دیسمبر"}, {"bbox": [284, 305, 364, 337], "text": "۲۰۳"}, {"bbox": [509, 304, 589, 338], "text": "۲۰۲۴"}, {"bbox": [706, 305, 790, 337], "text": "إيضاحات"}, {"bbox": [261, 337, 390, 367], "text": "بالآلاف الريالات"}, {"bbox": [486, 335, 617, 368], "text": "بآلاف الريالات"}, {"bbox": [283, 364, 366, 400], "text": "السعودية"}, {"bbox": [509, 364, 592, 401], "text": "السعودية"}, {"bbox": [280, 425, 398, 456], "text": "۲،۰۱،۵۲۹"}, {"bbox": [507, 428, 623, 453], "text": "۲،۳۱۳،۶۶۷"}, {"bbox": [1337, 421, 1437, 464], "text": "ربح السنة"}, {"bbox": [1008, 485, 1432, 517], "text": "بنود لن يعاد تصنيفها إلى قائمة الربح أو الخسارة:"}, {"bbox": [304, 515, 412, 554], "text": "(85,659)"}, {"bbox": [530, 518, 638, 554], "text": "(٥٨،٩١٥)"}, {"bbox": [732, 520, 767, 545], "text": "۲۳"}, {"bbox": [1035, 522, 1430, 546], "text": "الخسائر الإكتوارية لمزايا نهاية الخدمة للموظفين"}, {"bbox": [952, 551, 1431, 578], "text": "التغيرات في القيمة العادلة لاستثمار في أدوات حقوق ملكية"}, {"bbox": [338, 578, 408, 609], "text": "٤,١٧٤"}, {"bbox": [1166, 579, 1411, 608], "text": "من خلال الدخل الشامل الآخر"}, {"bbox": [612, 594, 623, 602], "text": "-"}, {"bbox": [894, 607, 1432, 639], "text": "بنود سيتم أو قد يعاد تصنيفها لاحقًا إلى قائمة الربح أو الخسارة:"}, {"bbox": [914, 639, 1432, 670], "text": "تسوية تحوطات التدفقات النقدية المحولة إلى مخزون / ممتلكات"}, {"bbox": [308, 670, 409, 701], "text": "(٧١،٤٦٤)"}, {"bbox": [550, 671, 632, 695], "text": "۳۴,۴۴۶"}, {"bbox": [1284, 668, 1411, 699], "text": "وآلات ومعدات"}, {"bbox": [293, 698, 408, 733], "text": "(١٤٦،٦٨٦)"}, {"bbox": [520, 699, 633, 731], "text": "(١٨١،٢٢٦)"}, {"bbox": [1184, 698, 1433, 728], "text": "فروقات ترجمة عملات أجنبية"}, {"bbox": [326, 731, 407, 755], "text": "۲۷،۴۶۵"}, {"bbox": [520, 729, 633, 761], "text": "(187,955)"}, {"bbox": [1019, 728, 1431, 758], "text": "الحركة في القيمة العادلة لتوطـات التدفقات النقدية"}, {"bbox": [305, 757, 409, 791], "text": "(١٤،٤٣٠)"}, {"bbox": [533, 760, 633, 789], "text": "(١٥،٤٧٨)"}, {"bbox": [908, 761, 1432, 788], "text": "تسوية تحوّطات التدفقات النقدية المحوّلة لقائمة الربح أو الخسارة"}, {"bbox": [295, 791, 409, 822], "text": "(286،600)"}, {"bbox": [520, 791, 635, 822], "text": "(٤٠٩،١٢٨)"}, {"bbox": [967, 791, 1430, 819], "text": "الخسارة الشاملة الأخرى للسنة، صافي من ضريبية الدخل"}, {"bbox": [287, 824, 408, 849], "text": "١،٧٦٤،٩٢٩"}, {"bbox": [512, 824, 633, 849], "text": "١،٩،٤،٥٣٩"}, {"bbox": [1201, 821, 1430, 852], "text": "إجمالي الدخل الشامل للسنة"}, {"bbox": [1004, 886, 1431, 916], "text": "إجمالي الدخل / (الخسارة) الشامل للسنة العائد إلى:"}, {"bbox": [293, 916, 407, 943], "text": "۱,۷۹۹,۹۸۶"}, {"bbox": [518, 916, 634, 943], "text": "۱،۹۰۲،۹۰۷"}, {"bbox": [1250, 918, 1431, 945], "text": "المساهمين في الشركة"}, {"bbox": [308, 946, 409, 977], "text": "(٣٥،٠٥٧)"}, {"bbox": [564, 944, 635, 976], "text": "١،٦٣٢"}, {"bbox": [1196, 949, 1429, 975], "text": "حقوق الملكيةَ غير المسيطرة"}, {"bbox": [284, 976, 409, 1006], "text": "۱،۷۶۴،۹۲۹"}, {"bbox": [510, 976, 635, 1006], "text": "۱،۹۰۴،۵۳۹"}, {"bbox": [240, 1042, 1440, 1070], "text": "تعتبر الإيضاحات المرفقة جزءًا لا يتجزأ من هذه القوائم المالية الموحدة، والتي تمنت الموافقة على إصدارها من قبل مجلس الإدارة بالنابية عن"}, {"bbox": [1078, 1074, 1438, 1100], "text": "المساهمين وتم توقيعها بالنية عنهم من قبل:"}, {"bbox": [266, 1284, 782, 1311], "text": "صاحب السمو الأمير نايف بن سلطان بن محمد بن سعود الكبير"}, {"bbox": [899, 1280, 1088, 1314], "text": "عبد الله بن ناصر البدر"}, {"bbox": [1256, 1280, 1371, 1316], "text": "دانکو ماراس"}, {"bbox": [435, 1313, 610, 1343], "text": "رئيس مجلس الإدارة"}, {"bbox": [924, 1310, 1063, 1347], "text": "الرئيس التنفيذي"}, {"bbox": [1257, 1309, 1370, 1347], "text": "المدير المالي"}, {"bbox": [831, 2115, 849, 2137], "text": "۸"}]