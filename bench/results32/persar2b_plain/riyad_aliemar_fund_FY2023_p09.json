[{"bbox": [1213, 199, 1457, 233], "text": "صندوق الرياض للإعمار"}, {"bbox": [1202, 235, 1457, 269], "text": "صندوق استثماري مفتوح"}, {"bbox": [1096, 269, 1456, 303], "text": "(مدار من قبل شركة الرياض المالية)"}, {"bbox": [1242, 303, 1457, 334], "text": "قائمة التدفقات النقدية"}, {"bbox": [988, 338, 1455, 375], "text": "(المبالغ بالريالات السعودية ما لم يذكر غير ذلك)"}, {"bbox": [236, 412, 351, 451], "text": "۳۱ دیسمبر"}, {"bbox": [471, 412, 595, 451], "text": "۳۱ دیسمبر"}, {"bbox": [258, 448, 330, 478], "text": "۲۰۲۲"}, {"bbox": [496, 449, 572, 478], "text": "۲۰۲۳"}, {"bbox": [675, 448, 750, 489], "text": "إيضاح"}, {"bbox": [1061, 485, 1441, 515], "text": "التدفقات النقدية من الأنشطة التشعيلية:"}, {"bbox": [253, 519, 414, 561], "text": "(٢٫٦٨٨٫٠٠٣)"}, {"bbox": [496, 520, 642, 555], "text": "۳,۳۶۳,۴۶۵"}, {"bbox": [1129, 520, 1442, 558], "text": "صافي الدخل / (الخسارة) للسنة"}, {"bbox": [1332, 558, 1444, 591], "text": "تعديلات ل:"}, {"bbox": [823, 591, 1441, 631], "text": "(ربح) / خسارة غير محققة من استثمارات مدرجة بالقيمة العادلة"}, {"bbox": [264, 626, 402, 661], "text": "۲,۸۲۵,۴۲۲"}, {"bbox": [487, 629, 655, 664], "text": "(١،٤٤٠،٣٢٣)"}, {"bbox": [704, 631, 725, 657], "text": "۹"}, {"bbox": [1160, 628, 1426, 665], "text": "من خلال الربح أو الخسارة"}, {"bbox": [293, 667, 403, 698], "text": "۱۳۷,۴۱۹"}, {"bbox": [501, 669, 642, 697], "text": "۱،۹۲۳،۱۴۲"}, {"bbox": [912, 700, 1441, 736], "text": "صافي التغيرات في الموجودات والمطلوبات التشتغيلية:"}, {"bbox": [253, 734, 414, 777], "text": "(١،١٦٥،٨٤٤)"}, {"bbox": [499, 737, 642, 771], "text": "۴,۳۴۶,۱۸۵"}, {"bbox": [863, 741, 1441, 771], "text": "استثمارات مدرجة بالقيمة العادلة من خلال الربح أو الخسارة"}, {"bbox": [306, 772, 404, 807], "text": "۲۳،۵۹۹"}, {"bbox": [586, 776, 640, 803], "text": "۴۲۰"}, {"bbox": [1231, 774, 1443, 810], "text": "توزيعات أرباح مدينة"}, {"bbox": [294, 810, 414, 849], "text": "(٧٢،٨٧٠)"}, {"bbox": [543, 808, 653, 851], "text": "(١،٤٦٥)"}, {"bbox": [1196, 810, 1442, 846], "text": "أتعاب إدارة مستحقة الدفع"}, {"bbox": [296, 847, 414, 882], "text": "(١٠،١٣٢)"}, {"bbox": [542, 847, 643, 878], "text": "۲۲،۴۲۵"}, {"bbox": [1202, 849, 1442, 879], "text": "مصاريف مستحقة أخرى"}, {"bbox": [255, 885, 412, 920], "text": "(1، 87،828)"}, {"bbox": [499, 884, 643, 915], "text": "۶،۲۹۰،۷۰۷"}, {"bbox": [874, 880, 1442, 921], "text": "صافي النقد الناتج من (المستخدم في) الأنشطة التشغيلية"}, {"bbox": [1062, 953, 1441, 989], "text": "التدفقات النقدية من الأنشطة التمويلية:"}, {"bbox": [264, 991, 402, 1024], "text": "۷,۲۹۵,۰۶۴"}, {"bbox": [502, 993, 641, 1024], "text": "۱,۸۳۱,۶۸۸"}, {"bbox": [1152, 992, 1442, 1026], "text": "متحصلات من إصدار وحدات"}, {"bbox": [256, 1029, 412, 1064], "text": "(٧٫٠٢٫٥٣٧)"}, {"bbox": [486, 1028, 652, 1065], "text": "(٨٫٥١٩٫٩٨٧)"}, {"bbox": [1250, 1032, 1440, 1060], "text": "استردادات الوحدات"}, {"bbox": [289, 1066, 404, 1099], "text": "۲۴۲،۵۲۷"}, {"bbox": [487, 1066, 651, 1103], "text": "(٦،٦٨٨،٢٩٩)"}, {"bbox": [877, 1063, 1441, 1103], "text": "صافي النقد (المستخدم في) / الناتج من الأنشطة التمويلية"}, {"bbox": [278, 1138, 415, 1180], "text": "(٨٤٥,٣٠١)"}, {"bbox": [512, 1138, 654, 1180], "text": "(۳۹۷,۵۹۲)"}, {"bbox": [1097, 1138, 1441, 1175], "text": "صافي التغيرات في النقد وما يماثله"}, {"bbox": [267, 1212, 404, 1243], "text": "۱,۵۲۳,۱۴۸"}, {"bbox": [525, 1213, 643, 1241], "text": "۶۷۷,۸۴۷"}, {"bbox": [1168, 1212, 1442, 1246], "text": "نقد وما يماثله في بداية السنة"}, {"bbox": [292, 1287, 403, 1315], "text": "۶۷۷,۸۴۷"}, {"bbox": [526, 1288, 643, 1316], "text": "۲۸۰,۲۵۵"}, {"bbox": [704, 1288, 725, 1313], "text": "۶"}, {"bbox": [1146, 1283, 1442, 1320], "text": "نقد وما يماثله في نهاية السنة"}, {"bbox": [623, 1357, 1457, 1396], "text": "تعتبر الإيضاحات المرققة من رقم ١ إلى رقم ١٧ جزءًا لا يتجزأ من هذه القوائم المالية."}, {"bbox": [806, 2246, 829, 2271], "text": "۷"}]