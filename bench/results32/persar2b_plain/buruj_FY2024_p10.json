[{"bbox": [1206, 205, 1498, 248], "text": "شركة بروج للتأمين التعاوني"}, {"bbox": [1241, 246, 1496, 283], "text": "(شركة مسـاهمة سعودية)"}, {"bbox": [1239, 290, 1497, 329], "text": "قائمة الدخل الشامل الآخر"}, {"bbox": [1099, 325, 1497, 369], "text": "اللسنة المنتهية في ٣١ ديسمبر ٢٠٢٤م"}, {"bbox": [1303, 366, 1496, 402], "text": "بالريالات السعودية"}, {"bbox": [184, 469, 398, 519], "text": "۳۱ دیسمبر ۲۰۲۳ م"}, {"bbox": [480, 474, 695, 515], "text": "۳۱ دیسمبر ۲۰۲۴م"}, {"bbox": [256, 585, 410, 619], "text": "۲۰،۰۸۳،۴۴۰"}, {"bbox": [565, 586, 713, 621], "text": "۹,۳۸۵,۵۶۵"}, {"bbox": [901, 583, 1513, 626], "text": "إجمالي دخل السنة العائد للمساهمين بعد الزكاة وضريبة الدخل"}, {"bbox": [1349, 694, 1518, 736], "text": "دخل شامل آخر:"}, {"bbox": [899, 746, 1516, 790], "text": "البنود التي لن يتم إعادة تصنيفها إلى قائمة الدخل في السنة"}, {"bbox": [1431, 796, 1520, 846], "text": "اللاحقة"}, {"bbox": [300, 859, 413, 890], "text": "۴۸۷,۶۱۹"}, {"bbox": [572, 859, 711, 891], "text": "۲،۴۸۰،۳۲۰"}, {"bbox": [1146, 855, 1515, 900], "text": "ربح اكتواري من مكافأة نهاية الخدمة"}, {"bbox": [949, 911, 1514, 952], "text": "صافي التغير في القيمة العادلة للاستتمارات بالقيمة العادلة"}, {"bbox": [273, 968, 413, 999], "text": "۳،۷۸۱،۱۲۵"}, {"bbox": [558, 968, 714, 999], "text": "۱۷،۶۲۰،۱۶۲"}, {"bbox": [1274, 964, 1508, 1005], "text": "من خلال الدخل الشامل"}, {"bbox": [257, 1024, 413, 1052], "text": "۲۴،۳۵۲،۱۸۴"}, {"bbox": [557, 1024, 715, 1052], "text": "۲۹،۵۳۶،۰۴۷"}, {"bbox": [1237, 1018, 1513, 1059], "text": "إجمالي الدخل الشامل للسنة"}, {"bbox": [1100, 1311, 1422, 1397], "text": "۳۳۷۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳۳"}, {"bbox": [213, 1325, 322, 1389], "text": "گوک"}, {"bbox": [316, 1293, 511, 1399], "text": "سیل موسسه"}, {"bbox": [946, 1374, 960, 1388], "text": "۷"}, {"bbox": [350, 1392, 585, 1450], "text": "الرئيس التنفيذي الحالي"}, {"bbox": [776, 1393, 943, 1451], "text": "الرئيس التنفيذي"}, {"bbox": [1143, 1402, 1348, 1442], "text": "عضو مجلس الإدارة"}, {"bbox": [485, 1545, 1239, 1582], "text": "تشكل الإيضاحات المرفقة من ١ إلى ٢٩ جزءًا لا يتجزأ من هذه القوائم المالية."}, {"bbox": [849, 2082, 873, 2107], "text": "۸"}]