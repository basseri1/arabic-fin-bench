[{"bbox": [1177, 81, 1498, 119], "text": "شركة أسواق عبد الله العثيم"}, {"bbox": [1210, 121, 1500, 158], "text": "(شركة مساهمة سعودية)"}, {"bbox": [1214, 168, 1498, 197], "text": "قائمة الدخل الشامل الموحدة"}, {"bbox": [1167, 206, 1499, 240], "text": "للسنة المنتية في ٣١ ديسمبر ٢٠٢٤م"}, {"bbox": [252, 286, 328, 321], "text": "۲۰۳"}, {"bbox": [512, 284, 588, 321], "text": "۲۲۰۲۴"}, {"bbox": [267, 309, 311, 350], "text": "فی"}, {"bbox": [527, 308, 574, 352], "text": "١٠٤"}, {"bbox": [716, 320, 785, 357], "text": "ایضاح"}, {"bbox": [208, 352, 369, 389], "text": "(معدَّلة إيضاح ٣٧)"}, {"bbox": [273, 425, 405, 452], "text": "٤٨٨٫٨٣٫١٦٤"}, {"bbox": [535, 425, 666, 452], "text": "۵۱۶,۳۳۳,۱۱۶"}, {"bbox": [1354, 424, 1495, 456], "text": "صافی ربح السنة"}, {"bbox": [1079, 490, 1495, 520], "text": "الدخل الشامل الاخر(الخسارة الشاملة الأخرى)"}, {"bbox": [934, 524, 1494, 553], "text": "ينود لا يمكن إعادة تصنيفها إلى قائمة الدخل في الفترات اللاحقة:"}, {"bbox": [269, 555, 408, 588], "text": "(٢١،٥١٤،٩٣٦)"}, {"bbox": [527, 555, 666, 586], "text": "(١٣،٢٣٢،٦٥٢)"}, {"bbox": [736, 558, 764, 584], "text": "۲۰"}, {"bbox": [1074, 558, 1493, 587], "text": "الخسائر الاكتوارية لمكافأة نهاية الخدمة للموظفين"}, {"bbox": [558, 592, 666, 620], "text": "۵,۲۹۸,۸۹۵"}, {"bbox": [737, 592, 765, 618], "text": "١٠"}, {"bbox": [809, 592, 1493, 621], "text": "صافى التغير في أدوات حقوق ملكية بالقيمة العادلة من خلال الدخل الشامل الآخر"}, {"bbox": [396, 604, 406, 613], "text": "-"}, {"bbox": [951, 658, 1495, 686], "text": "ينود يمكن إعادة تصنيفها إلى قائمة الدخل في الفترات اللاحقة:"}, {"bbox": [868, 693, 1494, 720], "text": "العصبة في الدخل الشامل الآخر (الخسارة الشاملة الأخرى) للشركات الزميلة"}, {"bbox": [320, 726, 407, 751], "text": "۱۹۴,۶۰۳"}, {"bbox": [560, 723, 668, 754], "text": "(١١٩٫٧٦٢)"}, {"bbox": [743, 727, 760, 749], "text": "۹"}, {"bbox": [1333, 725, 1479, 755], "text": "والمشروع المشترك"}, {"bbox": [329, 758, 408, 786], "text": "٧٠,٦٠٤"}, {"bbox": [541, 756, 668, 787], "text": "(٣،٤٣٢،٣٥٥)"}, {"bbox": [1068, 760, 1495, 787], "text": "فروقات ترجمة عملة اجنبية لشركة تابعة في الخارج"}, {"bbox": [271, 793, 407, 821], "text": "(٢١،٢٤٩،٧٢٩)"}, {"bbox": [528, 791, 668, 822], "text": "(١١،٤٨٥،٨٧٤)"}, {"bbox": [1281, 793, 1495, 821], "text": "الخسارة الشاملة الأخرى"}, {"bbox": [272, 828, 405, 855], "text": "۴۶۷,۳۳۳,۴۳۵"}, {"bbox": [533, 828, 667, 855], "text": "۵۰۴,۸۴۷,۲۴۲"}, {"bbox": [1238, 827, 1494, 857], "text": "إجمالي الدخل الشامل للسنة"}, {"bbox": [1395, 892, 1495, 930], "text": "العائد إلى:"}, {"bbox": [273, 931, 407, 958], "text": "۴۵۹,۹۷۳,۲۴۷"}, {"bbox": [534, 932, 667, 959], "text": "۴۹۹,۹۳۴,۱۸۳"}, {"bbox": [1319, 932, 1494, 960], "text": "مساهي الشركة الأم"}, {"bbox": [297, 966, 405, 991], "text": "٧,٣٦٠,١٨٨"}, {"bbox": [559, 964, 666, 992], "text": "۴,۹۱۳,۰۵۹"}, {"bbox": [1263, 967, 1493, 994], "text": "حقوق الملكية غير المسيطرة"}, {"bbox": [273, 1000, 406, 1027], "text": "۴۶۷,۳۳۳,۴۳۵"}, {"bbox": [533, 1000, 667, 1027], "text": "۵۰۴,۸۴۷,۲۴۲"}, {"bbox": [285, 1900, 496, 1992], "text": "الحکم"}, {"bbox": [770, 1952, 838, 1990], "text": "۳۳"}, {"bbox": [286, 2040, 475, 2078], "text": "رئيس مجلس الإدارة"}, {"bbox": [746, 2039, 910, 2078], "text": "الرئيس التنفيذي"}, {"bbox": [1123, 2041, 1422, 2077], "text": "الرئيس التنفيذي للشؤون المالية"}, {"bbox": [283, 2083, 478, 2127], "text": "عبدالله صالح العثيم"}, {"bbox": [734, 2087, 920, 2124], "text": "موفق عبد الله مباره"}, {"bbox": [1177, 2084, 1369, 2126], "text": "مروان أحمد إبراهيم"}, {"bbox": [445, 2208, 1208, 2240], "text": "إن الإيضاحات المرفقة من (١) إلى (٣٩) تشكل جزءًا لا يتجزأ من هذه القوائم المالية الموحدة."}, {"bbox": [817, 2250, 838, 2274], "text": "۸"}]