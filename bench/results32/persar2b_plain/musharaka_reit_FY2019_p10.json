[{"bbox": [1262, 84, 1463, 122], "text": "صندوق مشاركة ريت"}, {"bbox": [1127, 135, 1459, 171], "text": "(مدار من قبل شركة مشاركة المالية)"}, {"bbox": [1185, 178, 1462, 218], "text": "قائمة التدفقات النقدية (تتمة)"}, {"bbox": [1092, 226, 1463, 268], "text": "لسنة المنتهية في ٣١ ديسمبر ٢٠١٩"}, {"bbox": [225, 317, 414, 360], "text": "الفترة من ١٧ يوليو"}, {"bbox": [247, 369, 396, 405], "text": "٢٠١٧ الى ٣١"}, {"bbox": [247, 415, 394, 455], "text": "دیسمبر ۲۰۱۸"}, {"bbox": [561, 418, 629, 448], "text": "۲۰۱۹"}, {"bbox": [360, 467, 551, 505], "text": "(بالريالات السعودية)"}, {"bbox": [1290, 505, 1463, 553], "text": "الأنشطة التمويلية"}, {"bbox": [251, 567, 402, 601], "text": "۳۷۷,۱۰۰,۰۰۰"}, {"bbox": [1197, 569, 1460, 602], "text": "المتحصل من اصدار وحدات"}, {"bbox": [541, 617, 700, 658], "text": "(١،٢١٨،٠٥٩)"}, {"bbox": [1199, 624, 1459, 655], "text": "صافي التغير في التزام إيجار"}, {"bbox": [521, 676, 654, 703], "text": "۱۰۰۰۰"}, {"bbox": [1039, 673, 1459, 707], "text": "الحصول على تسهيلات مصرفية قصيرة الأجل"}, {"bbox": [510, 725, 698, 760], "text": "(۱۰۰۰۰,۰۰۰)"}, {"bbox": [1122, 725, 1459, 758], "text": "سداد تسهيلات مصرفية قصيرة الأجل"}, {"bbox": [254, 777, 407, 807], "text": "۱۶۰,۶۷۲,۷۵۰"}, {"bbox": [536, 779, 689, 807], "text": "۲۶،۰۱۵،۲۲۸"}, {"bbox": [980, 778, 1459, 812], "text": "صافي المتحصل من تسهيلات مصرفية طويلة الأجل"}, {"bbox": [273, 829, 420, 867], "text": "(٩٫٨٥٥٫٣٥١)"}, {"bbox": [525, 830, 699, 865], "text": "(١٨,٧٤٤,٤٠٢)"}, {"bbox": [1262, 833, 1460, 864], "text": "تكاليف تمويل مدفوعة"}, {"bbox": [257, 881, 422, 919], "text": "(٦١،٦٠٠،٠٠٠)"}, {"bbox": [524, 880, 702, 918], "text": "(٥٥،٤٤،٠٠٠)"}, {"bbox": [1256, 881, 1461, 918], "text": "توزيعات أرباح مدفوعة"}, {"bbox": [255, 938, 410, 966], "text": "۴۶۶,۳۱۷,۳۹۹"}, {"bbox": [523, 932, 701, 972], "text": "(٤٩،٣٨٧،٢٣٣)"}, {"bbox": [995, 933, 1459, 971], "text": "صافي النقد (المستخدم في) من الأنشطة التمويلية"}, {"bbox": [266, 1000, 409, 1031], "text": "۳۵,۱۲۷,۵۲۱"}, {"bbox": [525, 997, 701, 1036], "text": "(٢٢،٢٠١،٦٧٧)"}, {"bbox": [1125, 1002, 1458, 1033], "text": "صافي التغير في النقد وما في حكمه"}, {"bbox": [532, 1050, 688, 1085], "text": "۳۵,۱۲۷,۵۲۱"}, {"bbox": [1083, 1054, 1459, 1086], "text": "نقد وما في حكمه، في بداية السنة / الفترة"}, {"bbox": [267, 1107, 409, 1135], "text": "۳۵,۱۲۷,۵۲۱"}, {"bbox": [536, 1106, 688, 1137], "text": "۱۲،۹۲۵،۸۴۴"}, {"bbox": [1061, 1104, 1460, 1141], "text": "نقد وما في حكمه، في نهاية السنة / الفترة"}, {"bbox": [1269, 1170, 1461, 1204], "text": "معاملات غير نقدية:"}, {"bbox": [537, 1227, 687, 1255], "text": "۴۹،۳۰۷،۸۴۹"}, {"bbox": [944, 1225, 1459, 1260], "text": "أثر تطبيق المعيار الدولي للتقدير المالي ١٦ (إيضاح ٣)"}, {"bbox": [579, 1278, 688, 1306], "text": "۵۲۰،۳۰۵"}, {"bbox": [1001, 1281, 1457, 1310], "text": "تحويل تكاليف تسهيلات مؤجلة الى تسهيلات مالية"}, {"bbox": [536, 1332, 688, 1360], "text": "۲۸،۲۳۹،۶۷۳"}, {"bbox": [910, 1333, 1459, 1363], "text": "الاعتراف بالاستثمار في عقد إيجار تمويلي عند معاملة تبادل"}, {"bbox": [536, 1384, 687, 1412], "text": "۲۱،۹۸۳،۵۱۶"}, {"bbox": [866, 1385, 1457, 1417], "text": "عدم الاعتراف بالاستثمار في عقد إيجار تمويلي عند معاملة تبادل"}, {"bbox": [537, 1436, 687, 1463], "text": "۱۷,۳۹۳,۲۹۲"}, {"bbox": [991, 1437, 1458, 1467], "text": "التنازل عن التزامات إيجار تمويلي عند معاملة تبادل"}, {"bbox": [253, 1488, 339, 1515], "text": "۵۰۲,۹۰"}, {"bbox": [984, 1491, 1457, 1518], "text": "استحواذ على عقارات استثمارية مقابل اصدار وحدات"}, {"bbox": [478, 2152, 1179, 2186], "text": "تشكل الاضاحات المرفقة من ١ إلى ٢٩ جزءًا لا يتجزأ من هذه القوائم المالية"}, {"bbox": [798, 2201, 855, 2235], "text": "-۸-"}]