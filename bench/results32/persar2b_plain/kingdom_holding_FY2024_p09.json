[{"bbox": [1238, 199, 1469, 237], "text": "شركة المملكة القابضة"}, {"bbox": [1223, 238, 1465, 275], "text": "(شركة مسـاهمة سعودية)"}, {"bbox": [1183, 273, 1467, 307], "text": "قانمة الدخل الشامل الموحدة"}, {"bbox": [880, 308, 1465, 349], "text": "(جميع المبالغ بالآلف الريالات السعودية ما لم يذكر غير ذلك)"}, {"bbox": [245, 380, 557, 424], "text": "السنة المنتهية في ٣١ ديسمبر"}, {"bbox": [252, 422, 330, 455], "text": "۲۰۳۴"}, {"bbox": [471, 423, 552, 455], "text": "۲۰۳۴"}, {"bbox": [641, 420, 721, 466], "text": "إيضاح"}, {"bbox": [276, 490, 392, 526], "text": "۹۸۸،۲۴۲"}, {"bbox": [1323, 481, 1457, 536], "text": "الربح للسنة"}, {"bbox": [461, 489, 610, 526], "text": "1،207،166"}, {"bbox": [1106, 561, 1452, 595], "text": "الدخل / (الخسارة) الشاملة الأخرى"}, {"bbox": [1029, 599, 1455, 633], "text": "بنود لن يعاد تصنيفها إلى الربح أو الخسارة:"}, {"bbox": [896, 667, 1451, 701], "text": "خسارة غير محققة من استثمارات بالقيمة العادلة من خلال"}, {"bbox": [262, 700, 399, 735], "text": "٤،١٩،١٧٦"}, {"bbox": [460, 697, 609, 736], "text": "۳،۳۳۳،۳۰۰"}, {"bbox": [660, 703, 698, 732], "text": "١٠"}, {"bbox": [1240, 701, 1437, 735], "text": "الدخل الشامل الآخر"}, {"bbox": [316, 732, 403, 774], "text": "٦،٣٩٧"}, {"bbox": [523, 732, 611, 773], "text": "2،754"}, {"bbox": [660, 736, 702, 770], "text": "۳۲"}, {"bbox": [875, 734, 1451, 776], "text": "إعادة قياس الربح / (الخسارة) لالتزامات منافع نهاية الخدمة"}, {"bbox": [1031, 806, 1454, 842], "text": "بنود قد يعاد تصنيفها إلى الربح أو الخسارة:"}, {"bbox": [915, 843, 1450, 878], "text": "الحصة في الربح (الخسارة) الشاملة الأخرى للشركات"}, {"bbox": [287, 878, 400, 910], "text": "۱۰۷،۲۰۷"}, {"bbox": [504, 876, 612, 912], "text": "۳۷،۹۹۳"}, {"bbox": [659, 878, 701, 912], "text": "١١"}, {"bbox": [1099, 878, 1434, 912], "text": "المستتمر بها بطريقة حقوق الملكية"}, {"bbox": [970, 911, 1454, 950], "text": "تغیرات القيمة العادلة علی التحوط للتدفقات النقدیة"}, {"bbox": [526, 949, 610, 982], "text": "١،٥٥٤"}, {"bbox": [660, 949, 703, 982], "text": "۳۶