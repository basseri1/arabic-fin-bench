[{"bbox": [910, 94, 1491, 134], "text": "شركة فواز عبد العزيز الحكير وشركاه (شركة مساهمة سعودية)"}, {"bbox": [1209, 140, 1492, 175], "text": "قائمة الدخل الشامل الموحدة"}, {"bbox": [1160, 184, 1495, 224], "text": "للسنة المنهية في ٣١ ديسمبر ٢٠٢٤م"}, {"bbox": [357, 320, 512, 356], "text": "۳۱ دیسمبر ۲۰۲۳"}, {"bbox": [597, 318, 756, 352], "text": "۳۱ دیسمبر ۲۰۲۴"}, {"bbox": [757, 316, 844, 355], "text": "إيضاح"}, {"bbox": [1373, 368, 1494, 403], "text": "خسارة السنة"}, {"bbox": [344, 379, 514, 415], "text": "(١،١١٢،٨٠٧،٤٨٤)"}, {"bbox": [607, 376, 753, 411], "text": "(١٩٧،٤٦٣،٣٣٤)"}, {"bbox": [1126, 456, 1494, 491], "text": "بنود لن يعاد تصنيفها إلى الريح أو الخسارة:"}, {"bbox": [663, 505, 751, 536], "text": "۵۰۷,۶۱۴"}, {"bbox": [786, 501, 834, 532], "text": "۱۷"}, {"bbox": [407, 508, 515, 538], "text": "١،٤٤٤،٠٩٤"}, {"bbox": [1196, 498, 1495, 533], "text": "إعادة قياس التزامات منافع موظفين"}, {"bbox": [638, 548, 755, 575], "text": "۴۲،۰۳۴،۲۸۲"}, {"bbox": [785, 549, 831, 576], "text": "۱۰"}, {"bbox": [888, 539, 1495, 578], "text": "التفكير في إستثمار في أدوات حقوق ملكية بالقيمة العادلة من خلال الدخل"}, {"bbox": [1378, 578, 1499, 618], "text": "الشامل الآخر"}, {"bbox": [408, 635, 515, 667], "text": "١،٤٤٤،٠٩٤"}, {"bbox": [638, 633, 755, 664], "text": "۴۲،۵۴۱،۸۹۶"}, {"bbox": [988, 714, 1497, 750], "text": "بنود يتم أو يمكن إعادة تصنيفها لاحقًا إلى الريح أو الخسارة:"}, {"bbox": [380, 765, 518, 799], "text": "(٤١،٠٨٥،٩٨٨)"}, {"bbox": [623, 761, 756, 797], "text": "(٥٣،٥٧٤،٩٢٧)"}, {"bbox": [1084, 756, 1498, 791], "text": "العمليات الأجنبية - فروقات ترجمة عملات أجنبية"}, {"bbox": [379, 809, 518, 842], "text": "(٤١،٠٨٥،٩٨٨)"}, {"bbox": [623, 805, 758, 840], "text": "(۵۳،۵۷۴،۹۲۷)"}, {"bbox": [624, 846, 758, 882], "text": "(١١،٠٣٣،٠٣١)"}, {"bbox": [1260, 840, 1498, 875], "text": "الدخل الشامل الاخر للسنة"}, {"bbox": [380, 850, 519, 884], "text": "(۳۹،۶۴۱،۸۹۴)"}, {"bbox": [350, 895, 519, 929], "text": "(1,102,449,378)"}, {"bbox": [612, 892, 759, 925], "text": "(٢٠٨،٤٩٦،٣٦٥)"}, {