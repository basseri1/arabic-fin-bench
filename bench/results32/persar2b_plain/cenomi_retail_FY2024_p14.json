[{"bbox": [853, 74, 1438, 119], "text": "شركة فواز عبد العزيز الحكير وشركاه (شركة مساهمة سعودية)"}, {"bbox": [1062, 118, 1438, 157], "text": "قائمة التدفقات النقدية الموحدة (تتمة)"}, {"bbox": [1107, 165, 1442, 204], "text": "اللسنة المنتهية فی ٣١ ديسمبر ٢٠٢٤م"}, {"bbox": [592, 259, 748, 300], "text": "۳۱ دیسمبر ۲۰۲۴م"}, {"bbox": [778, 259, 849, 300], "text": "إيضاح"}, {"bbox": [286, 266, 445, 304], "text": "۳۱ دیسمبر ۲۲۰م"}, {"bbox": [1070, 290, 1432, 332], "text": "التدفقات النقدية من الأنشطة التمويلية:"}, {"bbox": [608, 347, 743, 382], "text": "۴۸۲،۹۲۰۰۶۰"}, {"bbox": [1117, 341, 1347, 374], "text": "المحصل من قروض وتسهيلات"}, {"bbox": [308, 353, 447, 388], "text": "۲۳۴،۲۴۷،۰۴۳"}, {"bbox": [1386, 351, 1395, 360], "text": "-"}, {"bbox": [573, 389, 745, 426], "text": "(١٫١٤٧٫٧١٫٨٩٥)"}, {"bbox": [1127, 383, 1348, 417], "text": "المسدد من قروض وتسهيلات"}, {"bbox": [295, 396, 445, 431], "text": "(٧٦٢،٩٧٨،٥٨٣)"}, {"bbox": [592, 432, 747, 468], "text": "(٣٢١،٨٨٨،٥٢.)"}, {"bbox": [1107, 425, 1348, 459], "text": "المسدد من التزامات عقود ايجار"}, {"bbox": [295, 438, 446, 474], "text": "(٤٠٧،٠٤٧،٨٤٤)"}, {"bbox": [295, 480, 447, 516], "text": "(٢١٦،٧٧٧،١٧٧)"}, {"bbox": [591, 472, 748, 512], "text": "(٢٥١،٦٩٠،٨٣٣)"}, {"bbox": [1052, 467, 1349, 504], "text": "المسدد من تكاليف التمويل على قروض"}, {"bbox": [297, 522, 447, 559], "text": "(١١٧،٨٥٥،١٢٧)"}, {"bbox": [593, 516, 748, 552], "text": "(١٠٦،٧٦٠،٩٦٣)"}, {"bbox": [782, 514, 840, 549], "text": "26"}, {"bbox": [966, 509, 1348, 547], "text": "المسدد من تكلفة التمويل على التزامات عقود ايجار"}, {"bbox": [1057, 546, 1433, 589], "text": "صافی النقد المستخدم في الأنشطة التمويلية"}, {"bbox": [279, 567, 448, 602], "text": "(1,170,311,688)"}, {"bbox": [576, 560, 749, 596], "text": "(1،344،492،101)"}, {"bbox": [628, 649, 748, 683], "text": "۹۵,۸۳۹,۷۳۰"}, {"bbox": [1093, 642, 1350, 675], "text": "صافي الزيادة في النقد وما في حكمه"}, {"bbox": [326, 656, 450, 688], "text": "۶۲،۷۶۱،۳۷۸"}, {"bbox": [610, 690, 752, 727], "text": "(٢٧،٧٦٩،٨٨٢)"}, {"bbox": [1141, 684, 1353, 715], "text": "فروق ترجمة عملات أجنبية"}, {"bbox": [312, 696, 451, 732], "text": "(١٨،٦٨٦،٨٦٢)"}, {"bbox": [617, 734, 754, 768], "text": "١٨٨,١٤١,٦٨٧"}, {"bbox": [1106, 726, 1354, 759], "text": "نقد وما في حكمه في بداية السنة"}, {"bbox": [317, 739, 450, 773], "text": "١٤٤،٠٦٧،١٧١"}, {"bbox": [617, 779, 754, 814], "text": "۲۵۶,۲۱۱,۵۳۴"}, {"bbox": [803, 777, 835, 804], "text": "١٤"}, {"bbox": [1169, 767, 1440, 805], "text": "نقد وما في حكمه في نهاية السنة"}, {"bbox": [319, 786, 452, 819], "text": "١٨٨،١٤١،٦٨٧"}, {"bbox": [738, 854, 1458, 901], "text": "تعتبر الإيضاحات المرفقة من ١ إلى ٣٤ جزءًا لا يتعجزًا من هذه القوائم المالية الموحدة."}, {"bbox": [812, 961, 945, 1082], "text": "۴۴"}, {"bbox": [266, 992, 652, 1104], "text": "کالیست ایلله‌لر"}, {"bbox": [809, 1073, 949, 1122], "text": "سليم فاخوري"}, {"bbox": [1212, 1062, 1372, 1112], "text": "أحمد عبدالكريم"}, {"bbox": [303, 1078, 511, 1129], "text": "فولانحبدالعزیز الحکیر"}, {"bbox": [803, 1115, 960, 1163], "text": "الرئيس التنفيذي"}, {"bbox": [1220, 1107, 1369, 1153], "text": "نائب المدير المالي"}, {"bbox": [317, 1132, 490, 1168], "text": "رئيس مجلس الإدارة"}, {"bbox": [1066, 2168, 1476, 2205], "text": "جميع المبالغ بالريال السعودي ما لم يذكر خلاف ذلك."}, {"bbox": [206, 2221, 237, 2246], "text": "١١"}]