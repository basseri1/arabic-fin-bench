{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arabic-fin-statements-gt/1.0",
  "title": "Ground truth for one Arabic financial-statement filing",
  "type": "object",
  "required": ["schema_version", "filing_id", "source", "statements"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "filing_id": {"type": "string", "pattern": "^[a-z0-9_]+_[A-Za-z0-9-]+$"},
    "entity": {"type": "string"},
    "source": {
      "type": "object", "required": ["sha256"], "additionalProperties": false,
      "properties": {
        "url": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "file": {"type": "string"}
      }
    },
    "period_end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "report": {"enum": ["annual", "interim"]},
    "consolidated": {"type": ["boolean", "null"]},
    "digits": {"enum": ["arabic-indic", "western", "mixed"]},
    "annotator": {"type": "string"},
    "verified_by": {"type": "string"},
    "comment": {"type": "string"},
    "statements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/statement"}}
  },
  "$defs": {
    "statement": {
      "type": "object", "required": ["id", "type", "pages", "unit", "columns", "rows"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["financial_position", "income", "comprehensive_income", "income_and_comprehensive_income",
                          "changes_in_equity", "changes_in_net_assets", "cash_flows", "other"]},
        "title_ar": {"type": "string"},
        "pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "unit": {
          "type": "object", "required": ["currency", "scale"], "additionalProperties": false,
          "properties": {"currency": {"type": "string"}, "scale": {"enum": [1, 1000, 1000000]}}
        },
        "columns": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id"], "additionalProperties": false,
            "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "period": {"type": "string"},
                           "currency": {"type": "string"}}
          }
        },
        "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}
      }
    },
    "row": {
      "type": "object", "required": ["id", "kind"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["section", "item", "subtotal", "total"]},
        "label_ar": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "string"}},
        "values": {"type": "object", "additionalProperties": {"oneOf": [{"type": "number"}, {"const": "nil"}]}},
        "sum_of": {"type": "array", "items": {"type": "string", "pattern": "^-?[A-Za-z0-9_]+$"}},
        "comment": {"type": "string"}
      }
    }
  }
}
